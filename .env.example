# Copie en .env.local pour le développement, ou récupère tout avec `vercel env pull .env.local`.
# Jamais de valeur réelle dans ce fichier.

# Postgres : rôle applicatif (sans DDL). En local : le Postgres Docker du README.
DATABASE_URL=postgres://postgres:test@localhost:54329/ances_tree
# Migrations seulement (rôle propriétaire, connexion directe). Jamais dans Vercel.
DATABASE_URL_UNPOOLED=

# better-auth : `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# URL publique ; déduite de VERCEL_BRANCH_URL en preview, localhost par défaut.
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Adresse du propriétaire, seul compte créé sans invitation.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Domaine racine des passkeys en production (folpe.me) ; l'hôte de l'app sinon.
PASSKEY_RP_ID=

# Emails. Sans clé en local, le lien de connexion s'affiche dans la console.
RESEND_API_KEY=
EMAIL_FROM=Racines <famille@mail.folpe.me>

# Seed : hôtes de branches Neon autorisés en plus de localhost (dev, preview).
SEED_ALLOWED_HOSTS=

# Photos : store Vercel Blob privé. Sur Vercel, l'accès passe par OIDC ; en local,
# `vercel env pull` fournit le jeton.
BLOB_READ_WRITE_TOKEN=
