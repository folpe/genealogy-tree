{
  "name": "racines",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "knip": "knip --no-progress",
    "audit": "bun audit --ignore GHSA-vfj7-8cjw-p6xm",
    "prepare": "lefthook install",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run --coverageAnalysis off",
    "start": "next start",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/db-seed.ts",
    "brand:icons": "bun scripts/brand-icons.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.6.33",
    "@better-auth/passkey": "~1.6.33",
    "@notionhq/client": "^2.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/blob": "2.8.1",
    "better-auth": "~1.6.33",
    "cmdk": "1.1.1",
    "d3-interpolate": "3.0.1",
    "d3-shape": "3.2.0",
    "drizzle-orm": "^0.45.3",
    "elkjs": "0.12.0",
    "gsap": "3.15.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.1",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "vaul": "1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "^9",
    "@stryker-mutator/vitest-runner": "^9",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "jsdom": "29.1.1",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "5.4.3",
    "tmp": "0.2.7",
    "qs": "6.16.0",
    "esbuild": "0.28.1"
  }
}
